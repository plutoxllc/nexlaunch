# LWA Client ID from your SP-API sandbox app client (Developer Central -> app -> LWA credentials)
SPAPI_CLIENT_ID=amzn1.application-oa2-client.REPLACE_ME

# LWA Client Secret for the same app client (keep secret — never commit .env)
SPAPI_CLIENT_SECRET=amzn1.oa2-cs.v1.REPLACE_ME

# Refresh token from self-authorizing the app for your own seller account
SPAPI_REFRESH_TOKEN=Atzr|REPLACE_ME

# SP-API endpoint — sandbox by default; switch to https://sellingpartnerapi-na.amazon.com once production is approved
SPAPI_BASE=https://sandbox.sellingpartnerapi-na.amazon.com

# ---------------------------------------------------------------------------
# Accounts + billing (added 2026-09-24)
# ---------------------------------------------------------------------------
# Stripe secret key. Test keys start sk_test_, live keys sk_live_.
# Without this, /api/billing/checkout returns a clear "not configured" error
# rather than pretending to work.
STRIPE_SECRET_KEY=

# Webhook signing secret from the Stripe dashboard (or `stripe listen`).
# WITHOUT THIS THE WEBHOOK IS REFUSED, WHICH IS THE SAFE DIRECTION: an
# unverified webhook endpoint hands a paid plan to anyone who can POST JSON.
STRIPE_WEBHOOK_SECRET=

# Price ids for each plan — create the products in Stripe first.
# These map to the pricing table on the landing page.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Where Stripe sends the customer back to. Must be the PUBLIC site origin,
# with no trailing slash, e.g. https://nexlaunch.example.com
NEXLAUNCH_SITE_URL=

# Where accounts.json is written. Defaults to server/data (gitignored).
# NEXLAUNCH_DATA_DIR=
